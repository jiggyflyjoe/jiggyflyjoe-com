---
import Layout from '../layouts/layout.astro';
---

<Layout title="Home">
	<section class="hero">
		<div class="hero-text">
			<h1 class="hero-headline">Hey, I'm <span class="accent"><em>jiggyflyjoe</span></em>! <span class="wave">👋</span> 🛸</h1>
			<p class="hero-content">You can call me “jiggy” or Joe. “jiggly” is factually incorrect, but still fine. I'm a gamer, content creator, blogger, media enthusiast, computer nerd, and proud cat dad. 🐾 I play games, self-host things that probably don't need to be self-hosted, and show off my handsome feline pals. I'm pretty chill until the caffeine kicks in, so stick around and hang out!</p>
			<div class="hero-links">
				<a href="/blog" class="btn">Latest Blog Posts</a>
				<a href="https://twitch.tv/jiggyflyjoe" class="btn btn-outline" target="_blank">Watch Live <i class="fa-brands fa-twitch fa-jello"></i></a>
			</div>
		</div>
		<div class="hero-image">
      <figure>
			  <img src="/PXL_20250818_2204133062-scaled.jpg" alt="jiggyflyjoe and his cat Rufus." />
        <figcaption><em>jiggyflyjoe and his BFF Rufus!</em></figcaption>
      </figure>
		</div>
	</section>
  
  <section class="advancedgg-block">
      <div class="advancedgg">
        <a href="https://advanced.gg/?ref=jiggy" target="_blank"><img src="/ADV-Horizontal-Light.png" alt="ADVANCED.gg logo"></a>
        <p>jiggyflyjoe.com is powered by ADVANCED! Click the logo or enter code <span class="glow"><strong>JIGGY</strong></span> at checkout for 10% off!</p>
    </div>
  </section>

	<section class="feed">
  <h2>Latest from <span class="accent">Bluesky</span> <i class="fa-brands fa-bluesky"></i></h2>
  <p class="feed-intro">What I've been posting lately.</p>
  <p class="feed-intro"><em>All opinions are my own and do not represent the opinions of anyone else or any company or organization I may be affiliated with!</em></p>

  <div class="feed-list" id="bluesky-feed">
    <div class="feed-list">
      <bsky-embed
        username="jiggyflyjoe.com"
        mode="dark"
        limit="6"
        link-target="_blank"
        link-image="true"
        load-more="true"
        disable-styles="false"
        custom-styles=".feed-card { width: 90% }"
        disable-autoplay="true"
        ></bsky-embed>
    </div>
</Layout>